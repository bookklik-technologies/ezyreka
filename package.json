{
  "name": "@bookklik/ezyreka",
  "version": "0.1.3",
  "description": "Embeddable, dependency-free JavaScript library for adding a Canva-style design editor to web apps, with JS API and data-ezr-editor auto-init.",
  "author": "a-hakim",
  "main": "dist/ezyreka.umd.js",
  "module": "dist/ezyreka.esm.js",
  "unpkg": "dist/ezyreka.umd.js",
  "jsdelivr": "dist/ezyreka.umd.js",
  "types": "types/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/ezyreka.esm.js",
      "require": "./dist/ezyreka.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.js",
    "dev": "node scripts/dev.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepublishOnly": "npm test && npm run build",
    "test": "node tests/smoke.test.mjs && node tests/charts.test.mjs && node tests/registry.test.mjs && node tests/extensibility.test.mjs && node tests/plugins.test.mjs && node tests/platform.test.mjs && node tests/dom.test.mjs && node tests/audit.test.mjs",
    "typecheck": "tsc -p tsconfig.types.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "canva",
    "design-editor",
    "canvas",
    "editor",
    "graphic-design",
    "wysiwyg",
    "no-code"
  ],
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^25.0.0",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "license": "MIT",
  "homepage": "https://bookklik-technologies.github.io/ezyreka/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bookklik-technologies/ezyreka.git"
  },
  "bugs": {
    "url": "https://github.com/bookklik-technologies/ezyreka/issues"
  },
  "overrides": {
    "vite": "6.4.4",
    "esbuild": "$esbuild",
    "source-map-js": "1.2.2"
  }
}
